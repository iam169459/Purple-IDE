{
  "name": "purple-ide",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/iam169459/Purple-IDE",
  "description": "A modern, lightweight code editor inspired by VSCode",
  "author": {
    "name": "Purple IDE",
    "email": "purple-ide@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && node scripts/start-electron.mjs",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "tsc && node scripts/copy-preload.mjs",
    "version:manifest": "node scripts/build-version-manifest.mjs",
    "start": "npm run build && node scripts/start-electron.mjs",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "generate-icons": "python3 scripts/generate-icons.py && iconutil -c icns build/icon.iconset -o build/icon.icns 2>/dev/null; echo 'Icons generated in build/'",
    "predist": "python3 scripts/generate-icons.py && iconutil -c icns build/icon.iconset -o build/icon.icns 2>/dev/null; true",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:start": "cd mcp-server && npm run start"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.0",
    "electron-builder": "^24.6.0",
    "electron-is-dev": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "build": {
    "appId": "com.purplide.app",
    "productName": "Purple IDE",
    "publish": {
      "provider": "github",
      "owner": "iam169459",
      "repo": "Purple-IDE"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Purple-IDE-${version}-mac-${arch}.${ext}",
      "darkModeSupport": true
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Purple-IDE-${version}-win-x64.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "Purple-IDE-${version}-linux-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Purple-IDE-${version}-win-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "Purple-IDE-${version}-win-x64-portable.${ext}"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "js-tiktoken": "^1.0.21",
    "node-pty": "^1.1.0"
  }
}
